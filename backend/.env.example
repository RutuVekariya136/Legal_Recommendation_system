# Copy this file to backend/.env and adjust as needed.
# backend/.env is git-ignored; this .example file is committed as the template.

# --- Application ---------------------------------------------------------
APP_NAME="Legal Case Similarity API"
APP_ENV=development
DEBUG=true

# --- Database ----------------------------------------------------------
# SQLite for local development (file-based, zero setup). Switching to
# PostgreSQL later is only a change to this URL, per PROJECT_NOTES.md §4.
DATABASE_URL=sqlite:///./legal_case_similarity.db

# --- Data / artifact locations (relative to the repo root) -------------
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_EMBEDDINGS_DIR=data/embeddings
DATA_GRAPHS_DIR=data/graphs
DATA_INDEXES_DIR=data/indexes

# --- Text similarity --------------------------------------------------
# tfidf | doc2vec (base paper) | sbert (our enhancement)
TEXT_SIMILARITY_METHOD=tfidf
SBERT_MODEL_NAME=all-MiniLM-L6-v2

# --- Hybrid similarity weights (weighted-sum variant) ----------------
# hybrid = HYBRID_ALPHA * text_score + HYBRID_BETA * network_score
HYBRID_ALPHA=0.5
HYBRID_BETA=0.5

# --- Recommendation -------------------------------------------------
DEFAULT_TOP_K=10

# --- CORS (frontend dev server) -----------------------------------
CORS_ORIGINS=http://localhost:5173
